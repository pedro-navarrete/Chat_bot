# ── Proveedor activo ──────────────────────────────────────────────────────────
# Opciones: "evolution" (default) | "cloud"
WHATSAPP_PROVIDER=evolution

# ── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=default
EVOLUTION_SERVER_URL=http://localhost:8080

# Secreto propio para el webhook (opcional; si está vacío, no se valida)
WEBHOOK_SECRET=

# ── WhatsApp Cloud API (usar si WHATSAPP_PROVIDER=cloud) ─────────────────────
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=whatsapp-files